<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>conflux_cpp</name>
  <version>0.2.0</version>
  <description>C++ library for multi-stream message synchronization</description>

  <maintainer email="todo@example.com">TODO</maintainer>
  <license>MIT</license>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/jerry73204/conflux</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <!-- L-27: explicit linters instead of the ament_lint_common meta-package, so
       that ament_uncrustify can be left out. This project formats C++ with
       clang-format (see .clang-format: Google style, 4-space indent), and ROS's
       uncrustify profile is a different, incompatible style. Running both means
       one of them is permanently red, which is what made the whole lint signal
       useless. Formatting is owned by `just format` / `just format-check`. -->
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
