# editor
*~
.*~
*.sw[op]
\#*#

# Rust
/target/
# H-14: `just test-ros2` builds conflux-ros2 outside the workspace, which
# creates its own target/ and Cargo.lock. Neither belongs in the repo -- the
# crate is excluded from the workspace precisely because its ROS dependencies
# are resolved at build time.
/crates/*/target/
/crates/conflux-ros2/Cargo.lock

# Generated by colcon-cargo-ros2
/.cargo/

# L-27: generated by conflux_cpp/rust/build.rs on every build. Tracking it made
# the file oscillate -- `just format-cpp` reformatted it, the next build
# regenerated it unformatted, and every commit carried the churn.
/conflux_cpp/include/conflux/conflux_ffi.h

# colcon
/build/
/install/
/log/

# external reference repos
/external/
